root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,xml,csproj,props,targets,slnx,runsettings}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{cs,vb}]
indent_size = 4
max_line_length = 140

# Language style — non-default values
dotnet_separate_import_directive_groups = true
dotnet_style_require_accessibility_modifiers = always
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary

# Analyzer categories
dotnet_analyzer_diagnostic.category-Design.severity = warning
dotnet_analyzer_diagnostic.category-Maintainability.severity = warning
dotnet_analyzer_diagnostic.category-Naming.severity = error
dotnet_analyzer_diagnostic.category-Performance.severity = warning
dotnet_analyzer_diagnostic.category-Reliability.severity = error
dotnet_analyzer_diagnostic.category-Security.severity = error
dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_analyzer_diagnostic.category-Usage.severity = error

# Design — enable disabled rules
# CA1002: Do not expose generic lists
dotnet_diagnostic.CA1002.severity = warning
# CA1031: Do not catch general exception types
dotnet_diagnostic.CA1031.severity = warning
# CA1034: Nested types should not be visible
dotnet_diagnostic.CA1034.severity = warning
# CA1052: Static holder types should be static or not inheritable
dotnet_diagnostic.CA1052.severity = warning
# CA1063: Implement IDisposable correctly
dotnet_diagnostic.CA1063.severity = warning
# CA1064: Exceptions should be public
dotnet_diagnostic.CA1064.severity = warning
# CA1065: Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1065.severity = warning

# Maintainability — enable disabled rules
# CA1502: Avoid excessive complexity
dotnet_diagnostic.CA1502.severity = warning
# CA1505: Avoid unmaintainable code
dotnet_diagnostic.CA1505.severity = warning
# CA1508: Avoid dead conditional code
dotnet_diagnostic.CA1508.severity = warning

# Naming — enable disabled rules
# CA1700: Do not name enum values 'Reserved'
dotnet_diagnostic.CA1700.severity = error
# CA1713: Events should not have Before or After prefix
dotnet_diagnostic.CA1713.severity = error
# CA1724: Type names should not match namespaces
dotnet_diagnostic.CA1724.severity = error

# Performance — enable disabled rules
# CA1802: Use literals where appropriate
dotnet_diagnostic.CA1802.severity = warning
# CA1819: Properties should not return arrays
dotnet_diagnostic.CA1819.severity = warning
# CA1820: Test for empty strings using string length
dotnet_diagnostic.CA1820.severity = warning
# CA1849: Use async methods in async context
dotnet_diagnostic.CA1849.severity = warning
# CA1851: Avoid multiple enumerations of IEnumerable
dotnet_diagnostic.CA1851.severity = warning

# Reliability — enable disabled rules
# CA2000: Dispose objects before losing scope
dotnet_diagnostic.CA2000.severity = error
# CA2002: Do not lock on objects with weak identity
dotnet_diagnostic.CA2002.severity = error
# CA2008: Do not create tasks without passing a TaskScheduler
dotnet_diagnostic.CA2008.severity = error
# CA2025: Do not pass disposables into unawaited tasks
dotnet_diagnostic.CA2025.severity = error

# Security — enable disabled rules
# CA2100: Review SQL queries for security vulnerabilities
dotnet_diagnostic.CA2100.severity = error
# CA5358: Do not use unsafe cipher modes
dotnet_diagnostic.CA5358.severity = error
# CA5394: Do not use insecure randomness
dotnet_diagnostic.CA5394.severity = error

# Style — suppress noisy rules
# IDE0008: Use explicit type
# 'var' is preferred in modern C#
dotnet_diagnostic.IDE0008.severity = none

# Usage — enable disabled rules
# CA2213: Disposable fields should be disposed
dotnet_diagnostic.CA2213.severity = error
# CA2214: Do not call overridable methods in constructors
dotnet_diagnostic.CA2214.severity = error
# CA2216: Disposable types should declare finalizer
dotnet_diagnostic.CA2216.severity = error
# CA2217: Do not mark enums with FlagsAttribute incorrectly
dotnet_diagnostic.CA2217.severity = error
# CA2225: Operator overloads should have named alternates
dotnet_diagnostic.CA2225.severity = error
# CA2227: Collection properties should be read-only
dotnet_diagnostic.CA2227.severity = error
# CA2234: Pass System.Uri objects instead of strings
dotnet_diagnostic.CA2234.severity = error
# CA2243: Attribute string literals should parse correctly
dotnet_diagnostic.CA2243.severity = error

[*.cs]
csharp_style_namespace_declarations = file_scoped

[test/**/*.cs]
# CA1707: Identifiers should not contain underscores
# Test methods use Method_Scenario_ExpectedResult naming — underscores are intentional
dotnet_diagnostic.CA1707.severity = none
# IDE0058: Remove unnecessary expression value
# Test assertions (e.g. EnsureSuccessStatusCode) intentionally discard return values
dotnet_diagnostic.IDE0058.severity = none
# IDE0290: Use primary constructor
# Explicit constructor preferred in test classes for clarity
dotnet_diagnostic.IDE0290.severity = none
